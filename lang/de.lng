folderSelect.dialog = Ordner, dessen Kopien ausgewählt werden
folderSelect.confirm = Auswählen

delete.title.one = {count} Datei löschen?
delete.title.other = {count} Dateien löschen?
delete.permanentText = {bytes} werden endgültig gelöscht. Dies kann nicht rückgängig gemacht werden.
delete.recycleText = {bytes} werden in den Papierkorb verschoben; bei Bedarf können Sie sie dort wiederherstellen.
delete.fullyWarning.one = In {count} Gruppe sind alle Kopien ausgewählt. Aus Sicherheitsgründen werden die Dateien dieser Gruppe nicht gelöscht.
delete.fullyWarning.other = In {count} Gruppen sind alle Kopien ausgewählt. Aus Sicherheitsgründen werden die Dateien dieser Gruppen nicht gelöscht.
delete.permanentCheck = Papierkorb nicht verwenden, endgültig löschen
delete.confirmPermanent = Endgültig löschen
