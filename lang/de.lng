outcome.renamed.other = {count} Dateien umbenannt

report.title = {ok} erfolgreich, {failed} fehlgeschlagen
report.noRecycle.one = {count} Datei liegt auf einem Laufwerk ohne Papierkorb (Netzlaufwerk, USB-Stick). Sie kann nur endgültig gelöscht werden.
report.noRecycle.other = {count} Dateien liegen auf einem Laufwerk ohne Papierkorb (Netzlaufwerk, USB-Stick). Sie können nur endgültig gelöscht werden.
report.warnings.one = {count} Datei wurde verarbeitet, aber ihr Datenbankeintrag konnte nicht aktualisiert werden; dies wird beim nächsten Scan behoben.
report.warnings.other = {count} Dateien wurden verarbeitet, aber ihre Datenbankeinträge konnten nicht aktualisiert werden; dies wird beim nächsten Scan behoben.
