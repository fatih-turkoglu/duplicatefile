scan.stop = Anhalten
scan.stopping = Wird angehalten …
scan.stopHint = Wenn Sie anhalten, wird alles bisher Berechnete gespeichert; der nächste Scan setzt dort schnell fort.

summary.completed = Scan abgeschlossen
summary.stopped = Scan angehalten
summary.stoppedInfo = Die berechneten Informationen wurden gespeichert. Starten Sie den Scan erneut, um die Duplikate zu sehen; bereits gelesene Dateien werden nicht erneut gelesen.
summary.groups = Duplikatgruppen
summary.groupsSimilar = Gruppen ähnlicher Bilder
summary.wasted = Freigebbarer Speicher
summary.dupFiles = Doppelte Dateien
summary.dupFilesSimilar = Bilder in Gruppen
summary.scanned = Gescannte Dateien
summary.scannedSimilar = Gescannte Bilder
summary.cached = Aus dem Cache
summary.read = Gelesen
summary.readValue.one = {count} Datei · {bytes}
summary.readValue.other = {count} Dateien · {bytes}
summary.duration = Dauer
summary.removed = Bereinigte Einträge
summary.errors.one = Auf {count} Datei oder Ordner konnte nicht zugegriffen werden
summary.errors.other = Auf {count} Dateien oder Ordner konnte nicht zugegriffen werden
summary.errorsTruncated = Die ersten {count} Fehler werden angezeigt.
summary.show = Duplikate anzeigen
summary.showSimilar = Ähnliche Bilder anzeigen
summary.none = Keine Duplikate gefunden
summary.noneSimilar = Keine ähnlichen Bilder gefunden

scanError.changed = Die Datei hat sich während des Scans geändert
scanError.image_unreadable = Das Bild konnte nicht gelesen werden
scanError.image_too_large = Das Bild ist zu groß

results.title = Duplikate
results.explorerFailed = Explorer konnte nicht geöffnet werden: {error}
results.opFailed = Der Vorgang ist fehlgeschlagen: {error}
results.folderSelected.one = {count} Datei ausgewählt.
results.folderSelected.other = {count} Dateien ausgewählt.
results.folderSkipped.one = In {count} Gruppe liegen alle Kopien in diesem Ordner, daher wurde eine nicht ausgewählt.
results.folderSkipped.other = In {count} Gruppen liegen alle Kopien in diesem Ordner, daher wurde jeweils eine nicht ausgewählt.
results.none = Keine Duplikate gefunden
results.noneText = In den ausgewählten Ordnern gibt es keine Dateien mit identischem Inhalt.
results.noneSimilarText = In den ausgewählten Ordnern gibt es keine ähnlichen Bilder.
results.empty = Noch keine Ergebnisse
results.emptyText = Starten Sie einen Scan, um doppelte Dateien zu sehen.
results.goScan = Zum Scan
results.saved = Diese Ergebnisse stammen aus einem früheren Scan; Dateien können sich seitdem geändert haben oder gelöscht worden sein.
results.rescan = Erneut scannen
results.dangerous.one = In {count} Gruppe sind alle Dateien ausgewählt. Werden sie gelöscht, bleibt von dieser Gruppe nichts übrig.
results.dangerous.other = In {count} Gruppen sind alle Dateien ausgewählt. Werden sie gelöscht, bleibt von diesen Gruppen nichts übrig.
results.noMatch = Keine Dateien entsprechen „{query}“.

