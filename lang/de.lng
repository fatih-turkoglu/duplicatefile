settings.moveDefault = An den Standardort verschieben
settings.moved = Datenbank verschoben: {path}
settings.maintenance = Wartung
settings.maintenanceText = Die Datenbank speichert Informationen über gescannte Dateien, damit wiederholte Scans schneller sind. Während eines Scans oder Dateivorgangs ist keine Wartung möglich.
settings.compactTitle = Datenbank komprimieren
settings.compactText = Gibt den Platz gelöschter Einträge an den Datenträger zurück.
settings.compactAction = Komprimieren
settings.compactDone = Komprimiert: {before} → {after}
settings.pruneTitle = Einträge gelöschter Dateien bereinigen
settings.pruneText = Entfernt Einträge von Dateien, die nicht mehr auf dem Datenträger existieren. Einträge auf nicht verbundenen Laufwerken bleiben erhalten.
