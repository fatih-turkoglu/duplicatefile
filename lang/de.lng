settings.pruneDone.one = {count} Eintrag bereinigt.
settings.pruneDone.other = {count} Einträge bereinigt.
settings.pruneNone = Keine Einträge zu bereinigen.
settings.clearTitle = Cache vollständig leeren
settings.clearText = Löscht alle Einträge. Der nächste Scan liest alle Dateien erneut; Ihre Dateien werden nicht angetastet.
settings.clearAction = Cache leeren
settings.clearConfirmTitle = Cache leeren?
settings.clearConfirmCount.one = {count} Dateieintrag wird gelöscht.
settings.clearConfirmCount.other = {count} Dateieinträge werden gelöscht.
settings.clearConfirmText = Ihre Dateien werden nicht angetastet, aber der nächste Scan dauert länger, weil er alle Dateien erneut liest. Die angezeigten Ergebnisse werden ebenfalls entfernt.
settings.clearConfirm = Leeren
settings.clearDone = Cache geleert.
settings.taskFailed = {task} fehlgeschlagen: {error}
