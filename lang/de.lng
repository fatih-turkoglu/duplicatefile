# DuplicateFile Sprachdatei — Deutsch
# Format: "Schlüssel = Text"; Zeilen mit # sind Kommentare. {Platzhalter} nicht ändern.

@name = Deutsch
@locale = de-DE

app.tagline = Finder für doppelte und ähnliche Dateien

common.cancel = Abbrechen
common.close = Schließen
common.ok = OK
common.starting = Wird gestartet …

nav.scan = Scannen
nav.results = Duplikate
nav.settings = Einstellungen

theme.system = System
theme.light = Hell
theme.dark = Dunkel
theme.tooltip = Design: {current} (klicken für {next})
theme.change = Design wechseln

unit.B = B
unit.KB = KB
unit.MB = MB
unit.GB = GB
unit.TB = TB

duration.ms = {n} ms
duration.s = {n} s
duration.minSec = {m} Min. {s} s
duration.hourMin = {h} Std. {m} Min.

crash.title = Ein unerwarteter Fehler ist aufgetreten
crash.text = Laden Sie die Oberfläche neu, um fortzufahren; Ihre Dateien und Daten sind nicht betroffen.
crash.reload = Neu laden

scan.title = Scannen
scan.failed = Der Scan konnte nicht durchgeführt werden: {error}
scan.roots.title = Zu scannende Ordner
scan.roots.add = Ordner hinzufügen
scan.roots.dialog = Zu scannenden Ordner auswählen
scan.roots.empty = Noch kein Ordner ausgewählt. Sie können mehrere Ordner hinzufügen; auch Duplikate zwischen ihnen werden gefunden.
scan.mode.title = Wonach suchen?
scan.mode.exact = Exakte Duplikate
scan.mode.similar = Ähnliche Bilder
scan.mode.exactHelp = Findet Dateien, deren Inhalt Byte für Byte identisch ist.
scan.mode.similarHelp = Findet verkleinerte, neu komprimierte oder leicht bearbeitete Fotos. Nur JPG, PNG, GIF, BMP, TIFF und WebP werden gescannt (HEIC wird nicht unterstützt).
scan.threshold.label = Ähnlichkeitsschwelle: {value}
scan.threshold.strict = Streng
scan.threshold.similar = Ähnlich
scan.threshold.loose = Locker
scan.threshold.help = Ein niedriger Wert findet weniger, aber sicherere Treffer; ein hoher Wert kann auch unterschiedliche Fotos zuordnen.
scan.options.title = Optionen
scan.minSize.label = Dateigröße
scan.minSize.help = Das Überspringen kleiner Dateien beschleunigt den Scan.
scan.minSize.all = Alle Dateien
scan.minSize.atLeast = {size} und größer
scan.ext.label = Dateitypen
scan.ext.placeholder = z. B. jpg eingeben und Enter drücken
scan.ext.help = Wenn leer, werden alle Dateitypen gescannt.
scan.ext.images = Bilder
scan.ext.videos = Videos
scan.ext.music = Musik
scan.ext.documents = Dokumente
scan.ext.archives = Archive
scan.ext.clear = Leeren
scan.skipHidden = Versteckte und Systemdateien überspringen
scan.exclude.title = Ausgeschlossene Ordner
scan.exclude.add = Ausgeschlossenen Ordner hinzufügen
scan.exclude.dialog = Ordner auswählen, der vom Scan ausgeschlossen wird
scan.exclude.empty = Keine. Die ausgewählten Ordner werden mit allen Unterordnern gescannt.
scan.start = Scan starten

folder.remove = Aus der Liste entfernen
folder.removeAria = Ordner {path} entfernen

scan.stage.walk = Dateien werden aufgelistet
scan.stage.walkImages = Bilder werden aufgelistet
scan.stage.partial = Schnellvergleich
scan.stage.full = Inhaltsvergleich
scan.stage.image = Bilder werden analysiert
scan.stage.cleanup = Entfernte Einträge
scan.stage.save = Wird gespeichert
