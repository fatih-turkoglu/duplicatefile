results.folderSkipped.other = Dans {count} groupes, toutes les copies sont dans ce dossier ; l’une d’elles n’a donc pas été sélectionnée.
results.none = Aucun doublon trouvé
results.noneText = Les dossiers sélectionnés ne contiennent aucun fichier au contenu identique.
results.noneSimilarText = Les dossiers sélectionnés ne contiennent aucune image similaire.
results.empty = Pas encore de résultats
