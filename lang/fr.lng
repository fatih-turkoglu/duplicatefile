scan.mode.title = Que rechercher ?
scan.mode.exact = Doublons exacts
scan.mode.similar = Images similaires
scan.mode.exactHelp = Trouve les fichiers dont le contenu est identique octet par octet.
scan.mode.similarHelp = Trouve les photos redimensionnées, recompressées ou légèrement retouchées. Seuls les fichiers JPG, PNG, GIF, BMP, TIFF et WebP sont analysés (HEIC n’est pas pris en charge).
scan.threshold.label = Seuil de similarité : {value}
scan.threshold.strict = Strict
scan.threshold.similar = Similaire
scan.threshold.loose = Souple
scan.threshold.help = Une valeur basse trouve moins de correspondances, mais plus sûres ; une valeur élevée peut aussi associer des photos différentes.
scan.options.title = Options
scan.minSize.label = Taille des fichiers
scan.minSize.help = Ignorer les petits fichiers accélère l’analyse.
scan.minSize.all = Tous les fichiers
scan.minSize.atLeast = {size} et plus
scan.ext.label = Types de fichiers
scan.ext.placeholder = p. ex. tapez jpg puis Entrée
scan.ext.help = Si vide, tous les types de fichiers sont analysés.
scan.ext.images = Images
scan.ext.videos = Vidéos
scan.ext.music = Musique
scan.ext.documents = Documents
scan.ext.archives = Archives
scan.ext.clear = Effacer
scan.skipHidden = Ignorer les fichiers cachés et système
scan.exclude.title = Dossiers exclus
scan.exclude.add = Ajouter un dossier exclu
scan.exclude.dialog = Choisir un dossier à exclure de l’analyse
scan.exclude.empty = Aucun. Les dossiers sélectionnés sont analysés avec tous leurs sous-dossiers.
scan.start = Lancer l’analyse

folder.remove = Retirer de la liste
folder.removeAria = Retirer le dossier {path}

scan.stage.walk = Inventaire des fichiers
