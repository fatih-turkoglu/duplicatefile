outcome.moved.other = {count} fichiers déplacés
outcome.renamed.one = {count} fichier renommé
outcome.renamed.other = {count} fichiers renommés

report.title = {ok} réussis, {failed} échoués
report.noRecycle.one = {count} fichier se trouve sur un lecteur sans Corbeille (lecteur réseau, clé USB). Il ne peut être supprimé que définitivement.
report.noRecycle.other = {count} fichiers se trouvent sur un lecteur sans Corbeille (lecteur réseau, clé USB). Ils ne peuvent être supprimés que définitivement.
report.warnings.one = {count} fichier a été traité, mais son entrée dans la base de données n’a pas pu être mise à jour ; cela sera corrigé à la prochaine analyse.
report.warnings.other = {count} fichiers ont été traités, mais leurs entrées dans la base de données n’ont pas pu être mises à jour ; cela sera corrigé à la prochaine analyse.
report.retryPermanent = Les supprimer définitivement

rename.titleOne = Renommer
