delete.title.one = Supprimer {count} fichier ?
delete.title.other = Supprimer {count} fichiers ?
delete.permanentText = {bytes} seront supprimés définitivement. Cette action est irréversible.
delete.recycleText = {bytes} seront envoyés à la Corbeille ; vous pourrez les y restaurer si nécessaire.
delete.fullyWarning.one = Dans {count} groupe, toutes les copies sont sélectionnées. Par sécurité, les fichiers de ce groupe ne seront pas supprimés.
delete.fullyWarning.other = Dans {count} groupes, toutes les copies sont sélectionnées. Par sécurité, les fichiers de ces groupes ne seront pas supprimés.
delete.permanentCheck = Ne pas utiliser la Corbeille, supprimer définitivement
delete.confirmPermanent = Supprimer définitivement
delete.confirmRecycle = Envoyer à la Corbeille

move.title.one = Déplacer {count} fichier
move.title.other = Déplacer {count} fichiers
move.target = Dossier de destination
move.notSelected = Non sélectionné
move.change = Modifier
move.choose = Choisir un dossier
move.dialog = Dossier vers lequel déplacer les fichiers
move.conflict = Si un fichier du même nom existe à la destination
move.conflictRename = Lui donner un nouveau nom (p. ex. photo (2).jpg)
move.conflictSkip = Ne pas déplacer ce fichier
move.note = Aucun fichier existant n’est jamais écrasé. Les fichiers déplacés restent dans la liste à leur nouvel emplacement.
move.confirm = Déplacer

progress.delete = Suppression…
progress.move = Déplacement…
progress.rename = Renommage…
progress.files = {done} / {total} fichiers

outcome.deletedPermanent.one = {count} fichier supprimé définitivement
outcome.deletedPermanent.other = {count} fichiers supprimés définitivement
