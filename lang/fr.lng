settings.resetDone = Les options d’analyse ont été rétablies.
settings.db = Base de données
settings.dbOpenFailed = Impossible d’ouvrir la base de données : {error}
settings.dbFallback = La base de données configurée n’a pas pu être ouverte ({error}) ; l’emplacement par défaut est utilisé.
