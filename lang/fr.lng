results.rescan = Relancer l’analyse
results.dangerous.one = Dans {count} groupe, tous les fichiers sont sélectionnés. S’ils sont supprimés, il ne restera rien de ce groupe.
results.dangerous.other = Dans {count} groupes, tous les fichiers sont sélectionnés. S’ils sont supprimés, il ne restera rien de ces groupes.
results.noMatch = Aucun fichier ne correspond à « {query} ».

