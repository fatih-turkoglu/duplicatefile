rename.more.other = … et {count} autres fichiers
rename.confirm = Renommer
rename.error.empty = Le nom ne peut pas être vide.
rename.error.trailing = Le nom ne peut pas se terminer par un espace ou un point.
rename.error.chars = Le nom ne peut pas contenir : < > : " / \\ | ? *
rename.error.reserved = {name} est un nom réservé par Windows.
rename.error.unchanged = Le nom ne change pas.
rename.error.duplicate = Un autre fichier du même dossier reçoit ce nom ; ajoutez {n} au modèle.

