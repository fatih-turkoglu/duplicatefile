settings.dbCustom = Emplacement personnalisé
settings.dbRecords.one = {count} entrée de fichier
settings.dbRecords.other = {count} entrées de fichiers
settings.dbScans.one = {count} analyse
settings.dbScans.other = {count} analyses
settings.showFolder = Afficher dans le dossier
settings.moveDb = Déplacer vers un autre dossier…
