# Fichier de langue DuplicateFile — Français
# Format : « clé = texte » ; les lignes commençant par # sont des commentaires. Ne pas modifier les {espaces réservés}.

@name = Français
@locale = fr-FR

app.tagline = Recherche de fichiers en double et similaires

common.cancel = Annuler
common.close = Fermer
common.ok = OK
common.starting = Démarrage…

nav.scan = Analyser
nav.results = Doublons
nav.settings = Paramètres

theme.system = Système
theme.light = Clair
theme.dark = Sombre
