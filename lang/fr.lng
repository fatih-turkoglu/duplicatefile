crash.title = Une erreur inattendue s’est produite
crash.text = Rechargez l’interface pour continuer ; vos fichiers et vos données ne sont pas affectés.
crash.reload = Recharger

scan.title = Analyser
scan.failed = L’analyse n’a pas pu être effectuée : {error}
scan.roots.title = Dossiers à analyser
scan.roots.add = Ajouter un dossier
scan.roots.dialog = Choisir un dossier à analyser
