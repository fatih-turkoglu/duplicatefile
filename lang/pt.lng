results.title = Duplicados
results.explorerFailed = Não foi possível abrir o Explorador: {error}
results.opFailed = A operação falhou: {error}
results.folderSelected.one = {count} arquivo selecionado.
results.folderSelected.other = {count} arquivos selecionados.
results.folderSkipped.one = Em {count} grupo todas as cópias estão nesta pasta, por isso uma ficou sem seleção.
results.folderSkipped.other = Em {count} grupos todas as cópias estão nesta pasta, por isso uma ficou sem seleção em cada um.
results.none = Nenhum duplicado encontrado
results.noneText = Não há arquivos com conteúdo idêntico nas pastas selecionadas.
results.noneSimilarText = Não há imagens semelhantes nas pastas selecionadas.
results.empty = Ainda não há resultados
results.emptyText = Inicie uma verificação para ver os arquivos duplicados.
results.goScan = Ir para a verificação
results.saved = Estes resultados foram salvos por uma verificação anterior; arquivos podem ter sido alterados ou excluídos desde então.
results.rescan = Verificar novamente
results.dangerous.one = Em {count} grupo todos os arquivos estão selecionados. Se forem excluídos, nada restará desse grupo.
results.dangerous.other = Em {count} grupos todos os arquivos estão selecionados. Se forem excluídos, nada restará desses grupos.
results.noMatch = Nenhum arquivo corresponde a “{query}”.

