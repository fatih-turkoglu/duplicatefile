settings.moved = Banco de dados movido: {path}
settings.maintenance = Manutenção
settings.maintenanceText = O banco de dados guarda informações sobre os arquivos verificados para que verificações repetidas sejam mais rápidas. Não é possível fazer manutenção durante uma verificação ou operação com arquivos.
settings.compactTitle = Compactar banco de dados
settings.compactText = Devolve ao disco o espaço deixado por registros excluídos.
settings.compactAction = Compactar
settings.compactDone = Compactado: {before} → {after}
settings.pruneTitle = Limpar registros de arquivos excluídos
settings.pruneText = Remove registros de arquivos que não existem mais no disco. Registros em unidades não conectadas são mantidos.
settings.pruneAction = Limpar registros
