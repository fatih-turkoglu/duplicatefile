# Arquivo de idioma do DuplicateFile — Português (Brasil)
# Formato: "chave = texto"; linhas iniciadas por # são comentários. Não altere os {marcadores}.

@name = Português
@locale = pt-BR

app.tagline = Localizador de arquivos duplicados e semelhantes

common.cancel = Cancelar
common.close = Fechar
common.ok = OK
common.starting = Iniciando…

nav.scan = Verificar
nav.results = Duplicados
nav.settings = Configurações

theme.system = Sistema
theme.light = Claro
theme.dark = Escuro
theme.tooltip = Tema: {current} (clique para {next})
theme.change = Alterar tema

unit.B = B
unit.KB = KB
unit.MB = MB
unit.GB = GB
unit.TB = TB

duration.ms = {n} ms
duration.s = {n} s
duration.minSec = {m} min {s} s
duration.hourMin = {h} h {m} min

crash.title = Ocorreu um erro inesperado
crash.text = Recarregue a interface para continuar; seus arquivos e registros não são afetados.
crash.reload = Recarregar

scan.title = Verificar
scan.failed = Não foi possível realizar a verificação: {error}
scan.roots.title = Pastas a verificar
scan.roots.add = Adicionar pasta
scan.roots.dialog = Escolha uma pasta para verificar
scan.roots.empty = Nenhuma pasta selecionada ainda. Você pode adicionar várias pastas; duplicados entre elas também são encontrados.
scan.mode.title = O que procurar?
scan.mode.exact = Duplicados exatos
scan.mode.similar = Imagens semelhantes
scan.mode.exactHelp = Encontra arquivos cujo conteúdo é idêntico byte a byte.
scan.mode.similarHelp = Encontra fotos redimensionadas, recomprimidas ou levemente editadas. Somente JPG, PNG, GIF, BMP, TIFF e WebP são verificados (HEIC não é suportado).
scan.threshold.label = Limite de semelhança: {value}
scan.threshold.strict = Rigoroso
scan.threshold.similar = Semelhante
scan.threshold.loose = Flexível
scan.threshold.help = Um valor baixo encontra menos correspondências, porém mais seguras; um valor alto pode associar fotos diferentes.
scan.options.title = Opções
scan.minSize.label = Tamanho do arquivo
scan.minSize.help = Ignorar arquivos pequenos acelera a verificação.
scan.minSize.all = Todos os arquivos
scan.minSize.atLeast = {size} ou mais
scan.ext.label = Tipos de arquivo
scan.ext.placeholder = ex.: digite jpg e pressione Enter
scan.ext.help = Se vazio, todos os tipos de arquivo são verificados.
scan.ext.images = Imagens
scan.ext.videos = Vídeos
scan.ext.music = Música
scan.ext.documents = Documentos
scan.ext.archives = Arquivos compactados
scan.ext.clear = Limpar
scan.skipHidden = Ignorar arquivos ocultos e do sistema
scan.exclude.title = Pastas excluídas
scan.exclude.add = Adicionar pasta excluída
scan.exclude.dialog = Escolha uma pasta a ser excluída da verificação
scan.exclude.empty = Nenhuma. As pastas selecionadas são verificadas com todas as subpastas.
scan.start = Iniciar verificação

folder.remove = Remover da lista
folder.removeAria = Remover a pasta {path}

scan.stage.walk = Listando arquivos
scan.stage.walkImages = Listando imagens
scan.stage.partial = Comparação rápida
scan.stage.full = Comparação de conteúdo
scan.stage.image = Analisando imagens
scan.stage.cleanup = Registros removidos
scan.stage.save = Salvando
scan.progress.step = Etapa {n}/{total}: {label}
scan.progress.found.one = {count} arquivo encontrado
scan.progress.found.other = {count} arquivos encontrados
scan.progress.files = {done} / {total} arquivos
scan.stop = Parar
scan.stopping = Parando…
scan.stopHint = Se você parar, tudo o que foi calculado até agora é salvo; a próxima verificação continua rapidamente a partir daí.

summary.completed = Verificação concluída
summary.stopped = Verificação interrompida
summary.stoppedInfo = As informações calculadas foram salvas. Reinicie a verificação para ver os duplicados; arquivos já lidos não são lidos novamente.
summary.groups = Grupos de duplicados
summary.groupsSimilar = Grupos de imagens semelhantes
summary.wasted = Espaço recuperável
summary.dupFiles = Arquivos duplicados
summary.dupFilesSimilar = Imagens nos grupos
summary.scanned = Arquivos verificados
summary.scannedSimilar = Imagens verificadas
summary.cached = Do cache
summary.read = Lidos
summary.readValue.one = {count} arquivo · {bytes}
summary.readValue.other = {count} arquivos · {bytes}
summary.duration = Duração
summary.removed = Registros limpos
summary.errors.one = {count} arquivo ou pasta não pôde ser acessado
summary.errors.other = {count} arquivos ou pastas não puderam ser acessados
summary.errorsTruncated = Mostrando os primeiros {count} erros.
summary.show = Mostrar duplicados
summary.showSimilar = Mostrar imagens semelhantes
summary.none = Nenhum duplicado encontrado
summary.noneSimilar = Nenhuma imagem semelhante encontrada

scanError.changed = O arquivo foi alterado durante a verificação
scanError.image_unreadable = Não foi possível ler a imagem
