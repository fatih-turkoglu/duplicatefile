folderSelect.dialog = Pasta cujas cópias serão selecionadas
folderSelect.confirm = Selecionar

delete.title.one = Excluir {count} arquivo?
delete.title.other = Excluir {count} arquivos?
delete.permanentText = {bytes} serão excluídos permanentemente. Isso não pode ser desfeito.
delete.recycleText = {bytes} serão enviados para a Lixeira; se necessário, você pode restaurá-los de lá.
delete.fullyWarning.one = Em {count} grupo todas as cópias estão selecionadas. Por segurança, os arquivos desse grupo não serão excluídos.
delete.fullyWarning.other = Em {count} grupos todas as cópias estão selecionadas. Por segurança, os arquivos desses grupos não serão excluídos.
delete.permanentCheck = Não usar a Lixeira, excluir permanentemente
delete.confirmPermanent = Excluir permanentemente
delete.confirmRecycle = Enviar para a Lixeira

move.title.one = Mover {count} arquivo
move.title.other = Mover {count} arquivos
move.target = Pasta de destino
move.notSelected = Não selecionada
move.change = Alterar
move.choose = Escolher pasta
move.dialog = Pasta para onde mover os arquivos
move.conflict = Se existir um arquivo com o mesmo nome no destino
move.conflictRename = Dar um novo nome (ex.: foto (2).jpg)
move.conflictSkip = Não mover esse arquivo
move.note = Nenhum arquivo existente é sobrescrito. Os arquivos movidos permanecem na lista com o novo local.
move.confirm = Mover

progress.delete = Excluindo…
progress.move = Movendo…
progress.rename = Renomeando…
