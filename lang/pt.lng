settings.pruneDone.other = {count} registros limpos.
settings.pruneNone = Não há registros para limpar.
settings.clearTitle = Limpar o cache completamente
settings.clearText = Exclui todos os registros. A próxima verificação lê todos os arquivos novamente; seus arquivos não são tocados.
settings.clearAction = Limpar cache
settings.clearConfirmTitle = Limpar o cache?
settings.clearConfirmCount.one = {count} registro de arquivo será excluído.
settings.clearConfirmCount.other = {count} registros de arquivos serão excluídos.
settings.clearConfirmText = Seus arquivos não são tocados, mas a próxima verificação demorará mais porque lerá todos os arquivos novamente. Os resultados na tela também serão removidos.
settings.clearConfirm = Limpar
settings.clearDone = Cache limpo.
