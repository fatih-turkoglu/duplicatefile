outcome.moved.other = {count} arquivos movidos
outcome.renamed.one = {count} arquivo renomeado
outcome.renamed.other = {count} arquivos renomeados

report.title = {ok} concluídos, {failed} com falha
report.noRecycle.one = {count} arquivo está em uma unidade sem Lixeira (unidade de rede, pen drive). Ele só pode ser excluído permanentemente.
report.noRecycle.other = {count} arquivos estão em uma unidade sem Lixeira (unidade de rede, pen drive). Eles só podem ser excluídos permanentemente.
report.warnings.one = {count} arquivo foi processado, mas seu registro no banco de dados não pôde ser atualizado; isso será corrigido na próxima verificação.
report.warnings.other = {count} arquivos foram processados, mas seus registros no banco de dados não puderam ser atualizados; isso será corrigido na próxima verificação.
report.retryPermanent = Excluir estes permanentemente

